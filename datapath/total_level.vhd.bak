library IEEE;
use IEEE.STD_LOGIC_1164.all

entity total_level is
	PORT (
	clk, ld_lev, clr_lev : in std_logic;
	PL : in std_logic_vector(3 downto 0);
	NL : out std_logic_vector(3 downto 0)
	);
end;

architecture arch of total_level is
begin
	total_level : entity work.total
		port map(
			clk => clk,
			ld => ld_lev,
			clr => clr_ld,
			I => PL,
			Q => NL
			);
end;